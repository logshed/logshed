# LogShed Environment Configuration
# NOTE: AI provider/keys and retention settings
# are configured at runtime via the web Settings UI (stored encrypted in the database)
# and must NOT be configured via environment variables.

# Docker endpoint (socket path or tcp:// proxy address)
DOCKER_HOST=unix:///var/run/docker.sock

# Source attribution alias for Docker logs (default: docker)
# DOCKER_SOURCE_ALIAS=docker

# Comma-separated list of container names or IDs to exclude from log tailing
# DOCKER_EXCLUDE_CONTAINERS=logshed,redis

# Container timezone
TZ=UTC

# Web UI & API port
PORT=8080

# Syslog UDP and TCP listening port (default: 1514)
# SYSLOG_PORT=1514

# Maximum concurrent Syslog TCP connections (default: 250)
# SYSLOG_MAX_TCP_CONNECTIONS=250

# Syslog TCP inactivity timeout in seconds (default: 0, disabled for persistent forwarders)
# SYSLOG_TCP_INACTIVITY_TIMEOUT=0

# Optional ceiling for log retention selectable in UI (default: 30 days, minimum 1)
# MAX_RETENTION_DAYS=30

# Minimum severity level for LogShed internal application logs (default: WARNING)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL, or DISABLED
# LOGSHED_INTERNAL_LOG_LEVEL=WARNING

# Set to true if running behind an SSL proxy not sending X-Forwarded-Proto
# COOKIE_SECURE=false

# Comma-separated trusted reverse proxy IPs/CIDRs (e.g. 172.16.0.0/12, 10.0.0.1)
# TRUSTED_PROXIES=

# User and Group ID for container permissions
PUID=1000
PGID=1000

# Optional Fernet master key override for secrets encryption.
# If unset, a key is automatically generated and stored at /data/.secret_key on first boot.
# LOGSHED_SECRET_KEY=

# Maximum concurrent Syslog TCP connections from one source IP (default: 20)
# SYSLOG_MAX_TCP_CONNECTIONS_PER_IP=20

# Largest POST /api/v1/ingest request body in bytes (default: 5242880, 5 MiB)
# INGEST_MAX_BODY_BYTES=5242880

# Time limit in milliseconds for one match of a user alert or drop rule regex (default: 50)
# USER_REGEX_TIMEOUT_MS=50

# Comma-separated extra Unix socket paths accepted for Docker hosts (default: empty).
# By default a unix:// host must end in docker.sock or be the DOCKER_HOST socket.
# DOCKER_ALLOWED_SOCKETS=/run/podman/podman.sock

# Accept MCP API tokens in the URL query string (default: false, deprecated).
# Prefer the Authorization: Bearer header.
# MCP_ALLOW_QUERY_TOKEN=false

# Serve /docs, /redoc and /openapi.json (default: true)
# ENABLE_API_DOCS=true

# Runtime mode: production (default) or development (adds localhost CORS origins)
# ENVIRONMENT=production

# Comma-separated allowed cross-origin hosts (default: empty). A * entry is ignored.
# CORS_ORIGINS=

# Allow PUID or PGID to be 0 (run as root). Default: false, the container refuses to start.
# ALLOW_ROOT=false
